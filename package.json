{
  "name": "jobpilot-desktop",
  "productName": "JobPilot",
  "version": "0.7.0",
  "private": true,
  "description": "JobPilot für den Desktop – Bewerbungen verwalten, mit Supabase als zentraler Datenbank",
  "keywords": [],
  "license": "MIT",
  "author": {
    "name": "Marco Hinkelmann",
    "email": "m.hinkelmann76@web.de"
  },
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "release": "electron-forge release",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "SUPABASE_INTEGRATION=1 vitest run src/data",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-deb": "^8.0.1",
    "@electron-forge/maker-rpm": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@testing-library/react": "^16.3.3",
    "@types/electron-squirrel-startup": "^1.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "45.3.0",
    "jsdom": "^31.0.1",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.93.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "electron-squirrel-startup": "^1.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "zod": "^4.6.7"
